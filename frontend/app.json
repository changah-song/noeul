{
  "expo": {
    "name": "Noeul",
    "slug": "FluentFable",
    "scheme": "noeul",
    "version": "1.2.0",
    "orientation": "portrait",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#202631"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon-ios.png",
      "bundleIdentifier": "com.noeulapp.Noeul",
      "usesAppleSignIn": true
    },
    "android": {
      "allowBackup": true,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#202631"
      },
      "package": "com.noeulapp.Noeul",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.738535121796-o3mq854ufrujemn8bqa26p72dmnl3uik"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "./plugins/withIosPodFixes",
      "./plugins/withIosSceneLifecycle"
    ],
    "extra": {
      "eas": {
        "projectId": "432f2363-e118-4789-8150-3b386f47cf00"
      }
    },
    "owner": "casong00"
  }
}
